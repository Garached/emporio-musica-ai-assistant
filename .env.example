# Google Gemini API key.
# Get one for free at Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (optional, defaults to gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash

# Thinking level (optional): minimal, low, medium or high. Defaults to low
# (faster and cheaper, enough for customer service).
GEMINI_THINKING_LEVEL=low

# Optional: override "today" (store timezone, America/Campo_Grande) for demos.
# The data is a snapshot from early 2026. Use an ISO date or datetime, e.g.:
#   EMPORIO_TODAY=2026-03-20
#   EMPORIO_TODAY=2026-03-20T14:30
# Leave empty to use the real current time.
EMPORIO_TODAY=
